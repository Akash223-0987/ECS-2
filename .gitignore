# Python byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables, credentials & secrets
.env
.env.*
!.env.example
*.json
!ml_service/models/auxiliary-intent-baseline/*.json
!ml_service/data/**/*.json
!package*.json
!tsconfig*.json
authorized_user*.json
*client_secret*.json
*service_account*.json
*credentials*.json
*token*.json
*.pem
*.key
*.p12

# Local runner & environment scripts (preserve template examples)
run_watcher.ps1
!run_watcher.example.ps1
*.local.ps1
*.local.sh
*.local.bat

# Large ML weights and model binary files
*.pt
*.bin
*.onnx
*.safetensors
*.pth

# Model checkpoints and training caches
tmp_checkpoints/
checkpoint-*/
runs/
wandb/
.cache/
huggingface/

# Exclude large transformer fine-tuned weights, keep baseline joblib pipeline
ml_service/models/*
!ml_service/models/auxiliary-intent-baseline/
ml_service/models/*backup*/
ml_service/models/*-backup/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
